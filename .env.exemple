# Database
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_DIALECT=postgres
DB_DATABASE=
# true se o banco exigir SSL (usado só pelo `npm run migrate`)
DB_SSL=false

# Server
PORT=3000
FRONTEND_URL=http://localhost:5173

# Segurança
# Token que toda chamada deve mandar no header X-API-Key (gere um valor longo e aleatório)
API_KEY=banana123.
# Origens liberadas no CORS, separadas por vírgula.
# Se vazio: FRONTEND_URL, http://localhost:5173 e http://127.0.0.1:5174
CORS_ORIGINS=
